[Unit]
Description=H.265 SVRT Raspberry Pi receiver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=svrt-receiver
Group=svrt-receiver
SupplementaryGroups=video render
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SVRT_PAIRING_FILE=/var/lib/svrt-receiver/pairing
StateDirectory=svrt-receiver
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/svrt-receiver 9944
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
